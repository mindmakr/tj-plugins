// Clean URL-safe ASCII slug helpers.

function isAlphaNum(ch: string): boolean {
  return (ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9")
}

export function slugify(text: string): string {
  const lower = text.trim().toLowerCase()
  let out = ""
  let dash = false
  for (let i = 0; i < lower.length; i++) {
    const ch = lower.slice(i, i + 1)
    if (isAlphaNum(ch)) {
      if (dash && out.length > 0) {
        out = `${out}-`
      }
      out = `${out}${ch}`
      dash = false
    } else if (ch === " " || ch === "-" || ch === "_" || ch === "/" || ch === ".") {
      dash = true
    }
  }
  return out
}

export function slugifyMax(text: string, maxLen: number): string {
  const limit = Math.floor(maxLen)
  if (limit <= 0) {
    return ""
  }
  const full = slugify(text)
  if (full.length <= limit) {
    return full
  }
  let cut = full.slice(0, limit)
  while (cut.endsWith("-")) {
    cut = cut.slice(0, cut.length - 1)
  }
  return cut
}
